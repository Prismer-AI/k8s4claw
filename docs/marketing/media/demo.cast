[41.204739, "o", "\r  \u001b[0;32m✓\u001b[0m Ready                                         \r\n"]
[42.207245, "o", "\r\n\u001b[0;36m▸\u001b[0m \u001b[1mDeploying a workload that will OOMKill (32Mi limit, malloc loop)\u001b[0m\r\n"]
[42.776549, "o", "\u001b[2m# waiting for OOM (kernel + cgroup limit)...\u001b[0m\r\n"]
[43.579442, "o", "\u001b[2m# rule engine needs 2+ OOMs within window to auto-remediate\u001b[0m\r\n"]
[44.536662, "o", "\r  \u001b[2m...OOMs: 0 (need 2+ to match rule)\u001b[0m"]
[45.6797, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[46.825861, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[47.968246, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[49.113424, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[50.256002, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[51.405197, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[52.557447, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[53.696152, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[54.8402, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[55.978039, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[57.127754, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[58.276049, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[59.416846, "o", "\r  \u001b[2m...OOMs: 1 (need 2+ to match rule)\u001b[0m"]
[60.567713, "o", "\r\n"]
[60.567962, "o", "\u001b[0;33m$\u001b[0m \u001b[1mkubectl get pod oom-demo -n demo -o jsonpath=reason={.status.containerStatuses[0].lastState.terminated.reason} restarts={.status.containerStatuses[0].restartCount}{\"\r\n\"}\u001b[0m\r\n"]
[61.133426, "o", "reason=OOMKilled restarts=2\r\n"]
[61.136564, "o", "\u001b[0;31m\u001b[1m  ↑ OOMKilled 2x. Real. Kernel killed the process.\u001b[0m\r\n"]
[63.139027, "o", "\r\n\u001b[0;36m▸\u001b[0m \u001b[1mRegistering the Claw so operator can auto-remediate\u001b[0m\r\n"]
[63.665403, "o", "\u001b[2m# waiting for rule engine to match + execute...\u001b[0m\r\n"]
[64.539416, "o", "\r\n\u001b[0;36m▸\u001b[0m \u001b[1mClawOpsController detected the crash → auto-executed\u001b[0m\r\n"]
[65.024173, "o", "\u001b[0;33m$\u001b[0m \u001b[1mkubectl get clawopsescalation -n demo\u001b[0m\r\n"]
[65.592417, "o", "NAME                CLAW      TRIGGER     SEVERITY   PHASE          AGE\r\nchatbot-ops-n59fj   chatbot   OOMKilled   High       AutoExecuted   2s\r\nchatbot-ops-v4tdm   chatbot   OOMKilled   High       Pending        "]
[65.592669, "o", "2s\r\n"]
[66.68004, "o", "\r\n\u001b[0;36m▸\u001b[0m \u001b[1mThe architectural trick: intent annotation on the Claw CR\u001b[0m\r\n"]
[67.082995, "o", "\u001b[2m# other tools patch StatefulSets directly — we don't\u001b[0m\r\n"]
[67.886799, "o", "\u001b[0;33m$\u001b[0m \u001b[1mkubectl get claw chatbot -n demo -o yaml | grep -A3 ops-intent\u001b[0m\r\n"]
[67.95836, "o", "    claw.prismer.ai/ops-intent-gen: \"1776669612766\"\r\n    kubectl.kubernetes.io/last-applied-configuration: |\r\n"]
[67.958811, "o", "\r\n"]
[67.958877, "o", "\u001b[0;33m$\u001b[0m \u001b[1mkubectl get claw chatbot -n demo -o jsonpath={\"gen: \"}{.metadata.annotations.claw\\.prismer\\.ai/ops-intent-gen}{\"\r\n\"}\u001b[0m\r\n"]
[68.528831, "o", "gen: 1776669612766\r\n"]
[69.535769, "o", "\u001b[2m# single writer (ClawReconciler) consumes intents → zero controller contention\u001b[0m\r\n"]
[71.342348, "o", "\r\n\u001b[0;36m▸\u001b[0m \u001b[1mEvery action Ed25519-signed for audit\u001b[0m\r\n"]
[71.81282, "o", "  escalation:  chatbot-ops-n59fj\r\n  trigger:     OOMKilled (count: 2)\r\n  severity:    High\r\n  matched:     oom-bump-memory\r\n  action:      {\"action\":\"bump-memory\",\"params\":{\"field\":\"memory-limit\",\"max\":\"4Gi\",\"...\r\n  signed:      key=rule-engine, sig=4730ad8967a8ffa1...\r\n"]
[73.82145, "o", "\r\n"]
[73.821676, "o", "\u001b[0;32m\u001b[1m  AI agents managing their own Kubernetes.\u001b[0m\r\n\u001b[2m  No 2am page. Every action signed. LLM optional — degrades to notification.\u001b[0m\r\n"]
[73.821745, "o", "\r\n  \u001b[1m→ github.com/Prismer-AI/k8s4claw\u001b[0m\r\n\r\n"]
