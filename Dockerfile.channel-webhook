FROM golang:1.26.9-alpine AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -o /claw-channel-webhook ./cmd/channel-webhook/

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /claw-channel-webhook /claw-channel-webhook
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/claw-channel-webhook"]
