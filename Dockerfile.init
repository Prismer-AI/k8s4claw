FROM golang:1.26.9-alpine AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -o /claw-init ./cmd/claw-init/

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /claw-init /claw-init
USER 65532:65532
ENTRYPOINT ["/claw-init"]
